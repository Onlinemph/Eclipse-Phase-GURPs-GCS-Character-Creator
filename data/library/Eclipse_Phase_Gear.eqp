{
	"version": 5,
	"rows": [
		{
			"id": "ECpjUna0wRwXvSOBN",
			"description": "Eclipse Phase Essentials",
			"children": [
				{
					"id": "eqRFRW-jdOkFA9Jdt",
					"description": "Backup Insurance (1 year)",
					"local_notes": "Contract service: regular backups, and restoration from your last one if your cortical stack stops reporting. The difference between death being an inconvenience and being permanent. Anarchist habs provide the equivalent as mutual aid.",
					"legality_class": "4",
					"base_value": "6250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "6250"
					}
				},
				{
					"id": "e60CRYdsGQ4bZsfEh",
					"description": "Cornucopia Machine",
					"local_notes": "General-purpose nanofabricator, fridge-sized: nearly anything that fits inside, including weapons and morph parts, given feedstock and unlocked blueprints. Anarchist habs treat public CMs as infrastructure; the Consortium treats unlocked ones as felonies.",
					"legality_class": "2",
					"base_value": "125000",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "125000"
					}
				},
				{
					"id": "e1NPPgSwBGSQbQ6j5",
					"description": "Cortical Stack (replacement)",
					"local_notes": "DR 50, HP 2, homogenous. Diamond-lattice memory at the brainstem: continuous ego backup, survives most things that kill the morph. Called shot to reach it is skull (-7) then stack (-10) and needs 54+ penetrating; treat as untargetable in a firefight. Destroyed by plasma, antimatter, disintegrators, sustained 3000C+, or 30 seconds with a cutting tool on a body someone controls. Installed in every morph by default; this is the spare.",
					"legality_class": "4",
					"base_value": "1500",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "1500"
					}
				},
				{
					"id": "exXyFP5XuUB8ilAyE",
					"description": "Ecto (flexible tablet)",
					"local_notes": "Rollable mesh device for those without implants or those who want an air gap they can hold. Runs a muse, AR, and everything mesh inserts do, deniably.",
					"legality_class": "4",
					"base_value": "250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "250"
					}
				},
				{
					"id": "eslDXIUPEdU24hZj6",
					"description": "Ego Bridge",
					"local_notes": "Full ego upload/download rig: scan a mind from a brain or stack, install one into a new morph or cyberbrain. The centerpiece of every body bank. Resleeving takes minutes (cyberbrain) to an hour (biomorph).",
					"legality_class": "4",
					"base_value": "31250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "31250"
					}
				},
				{
					"id": "ecbevTlB_FIhLdQav",
					"description": "Ego Bridge, Portable",
					"local_notes": "Suitcase-sized field version. Slower (x3 time), and using one where anyone can see it invites the obvious questions.",
					"legality_class": "4",
					"base_value": "125000",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "125000"
					}
				},
				{
					"id": "eOdgYJkAhPrCQIMDC",
					"description": "Fabber, Desktop",
					"local_notes": "Hobby-sized nanofabricator: small goods (tools, clothes, electronics, drugs) from feedstock plus blueprints, minutes to hours per item. DRM-locked against restricted blueprints; jailbreaking is a Machinist + Computer Hacking project.",
					"legality_class": "4",
					"base_value": "6250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "6250"
					}
				},
				{
					"id": "ekbRt31P_rrS8i-8T",
					"description": "Gnat Surveillance Drone",
					"local_notes": "Fist-sized rotorcraft spy: full sensor package, near-silent, mesh-linked. The reason nobody believes in privacy anymore.",
					"legality_class": "4",
					"base_value": "1500",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "1500"
					}
				},
				{
					"id": "eCBhxE0clguKJNS1-",
					"description": "Guardian Angel Drone",
					"local_notes": "Personal defense rotorcraft: follows its principal, packs an agonizer or light kinetic weapon, reacts at machine speed. Popular with oligarchs and the justifiably paranoid.",
					"legality_class": "3",
					"base_value": "31250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "31250"
					}
				},
				{
					"id": "eaQIifJssNTR44Ej4",
					"description": "Healing Vat",
					"local_notes": "Nanotech regeneration tank: repairs any biomorph injury short of true death, regrows limbs and organs. Hours for wounds, days for rebuilds. Can also grow a morph from a cortical-stack genome given weeks.",
					"legality_class": "4",
					"base_value": "31250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "31250"
					}
				},
				{
					"id": "etszNl4K3tUo6RyEg",
					"description": "QE Comm Rig",
					"local_notes": "Quantum-entangled communicator: instantaneous, untappable, any distance. The catch is the qubit reservoir - each bit transmitted consumes entangled pairs that cannot be replenished remotely. Standard doctrine: 'we'll QE you the go signal, nothing else.'",
					"legality_class": "3",
					"base_value": "125000",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "125000"
					}
				},
				{
					"id": "ewTIj13Ok4IVYol53",
					"description": "QE Qubit Reservoir (low-capacity)",
					"local_notes": "Replacement entangled-pair cartridge, good for roughly a thousand words. Both halves must be manufactured together and physically transported apart.",
					"legality_class": "4",
					"base_value": "31250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "31250"
					}
				},
				{
					"id": "eAHank5sIHJSDwvfU",
					"description": "Servitor Drone",
					"local_notes": "Common utility bot (case-equivalent chassis, ALI pilot): fetches, carries, cleans, assists. Puppet-capable.",
					"legality_class": "4",
					"base_value": "6250",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "6250"
					}
				},
				{
					"id": "enIq8xr_9wF0lwrIi",
					"description": "Utilitool",
					"local_notes": "Smart-matter multitool: reshapes into most common hand tools. Counts as a basic toolkit for Mechanic, Electrician, and Armoury at -2.",
					"legality_class": "4",
					"base_value": "1500",
					"quantity": 1,
					"equipped": true,
					"calc": {
						"extended_value": "1500"
					}
				}
			],
