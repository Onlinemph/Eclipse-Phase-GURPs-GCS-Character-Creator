				{
					"id": "tIrUh0QezZRa57z2C",
					"name": "Watts-MacLeod Infection",
					"base_points": -10,
					"tags": [
						"Disadvantage",
						"Mental",
						"Async"
					],
					"local_notes": "The gateway trait: mandatory for all sleights; copied with your Ego across every resleeve and fork. Includes mandatory mental disorders worth at least -15 points (chosen with the GM; outside the disadvantage limit), detectability by Sense Infection and async hunters, +4 to resist further exsurgent infection, and the permanent low hum of something else in the architecture. Psi inhibitors suppress all sleights for hours per dose. 2e rule: sleights only express through a biological brain - an async sleeved in a synthmorph or infomorph carries the Infection but cannot use psi at all.",
					"calc": {
						"points": -10
					}
				},
				{
					"id": "tZ7agaPrBug8YOgzl",
					"name": "Psi (Level 1)",
					"base_points": 0,
					"local_notes": "Prerequisite gate, 0 points: the Infection has settled enough to express psi-chi sleights. Fictional gate, not a price - the sleights themselves carry the cost.",
					"tags": [
						"Advantage",
						"Mental",
						"Async"
					],
					"calc": {
						"points": 0
					}
				},
				{
