											"name": "Size",
											"reference": "B15",
											"cost_adj": "-10%",
											"levels": 2
										}
									],
									"calc": {
										"points": 77,
										"current_level": 12
									},
									"local_notes": "Chassis strength for a size +2 frame, taking ST from 20 to 32 for both striking and lifting. Eclipse Phase records bulk in Durability rather than SOM, so a direct aptitude conversion leaves large morphs at human strength. Priced with the Size limitation (B15) at -10% per point of Size Modifier. HP is unaffected and stays on the Durability rule."
								}
							],
