					"name": "Async Talent",
					"tags": [
						"Advantage",
						"Mental",
						"Async"
					],
					"points_per_level": 5,
					"can_level": true,
					"levels": 1,
					"local_notes": "Max 4. Adds to every sleight skill and to your side of every sleight Quick Contest; +1/level reactions from asyncs who recognize you.",
					"calc": {
						"points": 5,
						"current_level": 1
					}
				},
				{
					"id": "tZQYahu8bKsh7N7UE",
					"name": "Alternative Abilities (rule)",
					"base_points": 0,
					"tags": [
						"Async"
					],
					"local_notes": "GURPS Powers p. 11, standard for asyncs: pay full price for your most expensive sleight; every other sleight marked as an Alternative Ability costs 1/5 (enable the -80% modifier on it). Only one Alternative Ability can be in use at a time; switching takes a Ready maneuver. Always-on passives (most psi-chi, Psi Shield, Scramble) cannot be alternatives and are priced without the modifier. Defensive options: Psi Full Defense (All-Out Defense, Mental: +3 to resist sleights until your next turn). If a defender critically succeeds on a resistance roll, the async is locked out of that mind until they take a full rest.",
					"calc": {
						"points": 0
					}
				},
				{
					"id": "tP2G9PRO-eeZJ4BDn",
					"name": "Techniques: Penetration & Hide Signature",
					"base_points": 0,
					"tags": [
						"Technique",
						"Async"
					],
					"local_notes": "Penetration (Hard; defaults to any attack sleight's skill at -4; cannot exceed it): each level bought past default negates 1 level of the target's Psi Shield. Hide Signature (Hard; defaults to Scramble skill -4): opposes Sense Infection on you, stacking with Scramble.",
					"calc": {
						"points": 0
					}
				}
			],
			"calc": {
				"points": -5
			}
		},
